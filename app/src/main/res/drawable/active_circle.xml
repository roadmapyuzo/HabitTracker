<layer-list xmlns:android="http://schemas.android.com/apk/res/android">


    <item>
        <shape android:shape="oval">
            <size android:width="12dp" android:height="12dp"/>
            <solid android:color="#5532FF32"/> <!-- verde claro com transparência -->
        </shape>
    </item>


    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="oval">
            <solid android:color="#AA00FF00"/> <!-- verde médio -->
        </shape>
    </item>

    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">

        <shape android:shape="oval">
            <solid android:color="#00C853"/> <!-- verde forte -->
        </shape>
    </item>

</layer-list>