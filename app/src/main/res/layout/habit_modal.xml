<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/habit_modal_background">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="New habit"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#AFC7FF"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Habit name"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/edtHabitName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Ex: Drink alcohool"
        android:textColorHint="#ABABB3"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:background="@drawable/habit_modal_input_background"/>


    <View
        android:layout_width="match_parent"
        android:layout_height="16dp"/>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daily Goal"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/edtDailyGoal"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:hint="Max 5"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#ABABB3"
        android:background="@drawable/habit_modal_input_background"
        android:inputType="number"/>

    <!-- Espaço -->
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"/>

    <!-- Botões -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:background="@drawable/habit_modal_cancel_background"/>

        <View
            android:layout_width="12dp"
            android:layout_height="match_parent"/>

        <Button
            android:id="@+id/btnCreateHabit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Create"
            android:textColor="#FFFFFF"
            android:background="@drawable/habit_modal_confirm_background"/>

    </LinearLayout>

</LinearLayout>