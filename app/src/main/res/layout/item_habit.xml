<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habitCard"
    android:orientation="vertical"
    android:background="#E3F2FD"
    android:padding="16dp"
    android:layout_margin="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerArea"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/habitName"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/habitGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/habitTodayCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today: 0"
                android:textSize="14sp"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/completedIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"/>

        <Button
            android:id="@+id/markDoneButton"
            android:text="✓"
            android:layout_width="40dp"
            android:layout_height="40dp"/>

    </LinearLayout>

    <!-- Área expandida -->
    <LinearLayout
        android:id="@+id/weekContainer"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>